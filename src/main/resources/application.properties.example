spring.application.name=library-management-api

# PostgreSQL (override via environment variables)
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/library_db}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:CHANGE_ME}

# JPA / Hibernate (dialect is auto-detected)
spring.jpa.hibernate.ddl-auto=update

# Uncomment to inspect SQL (useful when verifying N+1 fixes):
# spring.jpa.show-sql=true
# spring.jpa.properties.hibernate.format_sql=true

# JWT (override via environment variables; secret must be at least 32 characters)
app.jwt.secret=${JWT_SECRET:CHANGE_ME_TO_A_SECURE_SECRET_KEY_AT_LEAST_32_CHARS}
app.jwt.access-expiration-ms=${JWT_ACCESS_EXPIRATION_MS:900000}
app.jwt.refresh-expiration-ms=${JWT_REFRESH_EXPIRATION_MS:604800000}

# Book read cache (Caffeine)
app.cache.books.maximum-size=${CACHE_BOOKS_MAXIMUM_SIZE:500}
app.cache.books.expire-after-write-minutes=${CACHE_BOOKS_EXPIRE_AFTER_WRITE_MINUTES:10}

# File uploads (default max size = 10 MB / 10485760 bytes)
app.file.storage-directory=${FILE_STORAGE_DIRECTORY:uploads}
app.file.max-size=${FILE_MAX_SIZE:10485760}
app.file.allowed-content-types=${FILE_ALLOWED_CONTENT_TYPES:image/jpeg,image/png,application/pdf}
spring.servlet.multipart.max-file-size=${FILE_MAX_SIZE:10485760}
spring.servlet.multipart.max-request-size=${FILE_MAX_SIZE:10485760}
